# Copy this file to .env and fill in your keys

# Free NewsAPI key — get one at https://newsapi.org (100 req/day free)
NEWSAPI_KEY=your_newsapi_key_here

# PostgreSQL (matches docker-compose defaults — change if using your own DB)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=finsentiment
DB_USER=postgres
DB_PASSWORD=postgres

# Days of news history to fetch per pipeline run
DAYS_BACK=30
